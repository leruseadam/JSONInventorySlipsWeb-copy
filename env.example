# Copy to .env and fill in real values. Do not commit .env.

# Flask dev (python app.py): defaults bind 0.0.0.0 and open http://127.0.0.1:PORT/ — avoids "can't reach" when localhost uses IPv6.
# FLASK_DEV_BIND=0.0.0.0
# FLASK_DEV_BROWSER_HOST=127.0.0.1
# Or set both bind + browser to one host: FLASK_DEV_HOST=127.0.0.1

POSABIT_ORDER_PAD_TOKEN=your_posabit_api_token_here
POSABIT_MENU_FEED_KEY_BOTHELL=your_menu_feed_uuid_here
POSABIT_MENU_FEED_KEY_SEATTLE=your_seattle_feed_key_here
POSABIT_MENU_FEED_KEY_BURIEN=your_burien_feed_key_here
POSABIT_MENU_FEED_KEY_LYNNWOOD=your_lynnwood_feed_key_here
# If POSaBit gives a separate path token for /{token}/v2/..., set it here (never use the Bearer/API token).
POSABIT_VENUE_TOKEN=
POSABIT_USE_VENUE_INVENTORIES=1
# When menu_feed returns 0 items, load /v2/venue/inventories for matching (recommended for retail SKUs).
POSABIT_FALLBACK_TO_VENUE_INVENTORY=1
POSABIT_INVENTORY_PER_PAGE=200
POSABIT_INVENTORY_MAX_PAGES=250
# Max wall-clock seconds spent on inventory pagination (then Data View continues without full SKU list).
POSABIT_INVENTORY_FETCH_BUDGET_SEC=45
POSABIT_API_BASE_URL=https://app.posabit.com/api
# Per HTTP call to POSaBit; lower = fail faster.
POSABIT_REQUEST_TIMEOUT=18
# After this many menu_items from one endpoint, skip trying remaining menu_feed URLs (faster loads).
POSABIT_MENU_FEED_STOP_AFTER_ITEMS=400
# Data View venue-inventory pagination (fallback when menu_feed is empty): keep low for responsive pages.
POSABIT_DATA_VIEW_INVENTORY_MAX_PAGES=22
POSABIT_DATA_VIEW_INVENTORY_BUDGET_SEC=28
# How long Data View waits for the POS fetch (menu + optional inventory + matching).
POSABIT_DATA_VIEW_FETCH_TIMEOUT_SEC=55
# When true (default), Data View HTML returns immediately and POS fills in via /api/data-view/pos-matches while the table is already visible.
POSABIT_DATA_VIEW_DEFER_MATCHING=true
# Fuzzy name cutoff (0–1). Higher = fewer loose matches.
# POSABIT_FUZZY_CUTOFF=0.76
# Match only within the same broad product family (flower vs edible vs vape vs concentrate, …).
POSABIT_MATCH_STRICT_CATEGORY=1
# Require imported Vendor text to overlap the POS line (brand + display + name + strain + description).
# POSABIT_MATCH_REQUIRE_BRAND=0
# When true (default), manifest brand hints must appear on the POS line: trailing ``… by Major`` and
# short leading ``Wyld - Sour …`` (1–2 words before the first `` - ``). Same text blob as REQUIRE_BRAND.
# POSABIT_MATCH_TRAILING_BY_BRAND=1
# When POS qty is blank on slips, fill “Old Units Remaining” from incoming manifest qty (set 0 to disable).
POSABIT_SLIP_OLD_UNITS_INCOMING_FALLBACK=1
USE_POSABIT_PRODUCTS=true
